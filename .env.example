# VITE_ADSGRAM_BLOCK_ID: Your Adsgram Rewarded Ad Block ID from https://adsgram.ai
# Must be numeric or start with 'int-' followed by digits (e.g. "int-4856")
VITE_ADSGRAM_BLOCK_ID="int-4856"

# VITE_TELEGRAM_BOT_USERNAME: The username of your Telegram Bot (without @)
VITE_TELEGRAM_BOT_USERNAME="MotoRush20Bot"

# VITE_TELEGRAM_APP_SHORT_NAME: The short name configured in @BotFather for the Mini App
VITE_TELEGRAM_APP_SHORT_NAME="play"

# APP_URL: The URL where this applet is hosted (Cloud Run or Vercel)
APP_URL="MY_APP_URL"
